{
  "ocr": {
    "optimize_level": 2,
    "ocr_languages_default": [
      "eng",
      "deu",
      "deu_latf",
      "fra",
      "rus",
      "lat",
      "spa",
      "por",
      "chi_sim",
      "chi_tra",
      "jpn",
      "ell",
      "kor"
    ],
    "gibberish_threshold": 0.65,
    "visual_script_gibberish_min": 0.4,
