:"Upper lateral ridges undivided. Thrust block with two pairs of lobes . . . . . . . . . . . . . . . . . . . .","column_header":false,"row_header":false,"row_section":false,"fillable":false},{"bbox":{"l":422.0317933199989,"t":651.5183272957802,"r":539.3212008476257,"b":660.2808917164803,"coord_origin":"TOPLEFT"},"row_span":1,"col_span":1,"start_row_offset_idx":7,"end_row_offset_idx":8,"start_col_offset_idx":2,"end_col_offset_idx":3,"text":". . . . Erenna insidiator sp. nov .","column_header":false,"row_header":false,"row_section":false,"fillable":false}],"num_rows":8,"num_cols":3,"orientation":"rot_0"},"annotations":[]}],"key_value_items":[],"form_items":[],"pages":{"42":{"size":{"width":595.0,"height":842.0},"page_no":42}}},"pdf_pages":{"42":{"height":842.0,"width":595.0,"lines":[{"bbox":[466.44000244140625,785.6420288085938,540.4994506835938,793.5596923828125],"spans":[{"text":"PUGH & HADDOCK "}]},{"bbox":[56.52000045776367,782.3997192382812,255.455322265625,794.3997192382812],"spans":[{"text":"442"},{"text":"  "},{"text":"·"},{"text":"  "},{"text":"Zootaxa"},{"text":" 4189 (3)  © 2016"},{"text":" "},{"text":"Magnolia Press"}]},{"bbox":[74.5199966430664,53.28277587890625,541.14990234375,66.29354095458984],"spans":[{"text":"Etymology. "},{"text":"The specific name "},{"text":"sirena"},{"text":" is derived from the sirens of Greek mythology, who lured sailors to their "}]},{"bbox":[56.51942443847656,69.31802368164062,470.59375,79.75496673583984],"spans":[{"text":"death, in reference to the function of the bioluminescent tentilla this species uses to attract its prey."}]},{"bbox":[74.5189437866211,82.75845336914062,541.1727294921875,93.29341888427734],"spans":[{"text":"Genetic results."},{"text":" Molecular sequences for the nuclear 18S and 28S ribosomal RNA genes were largely "}]},{"bbox":[56.519432067871094,93.84210205078125,541.1757202148438,106.75484466552734],"spans":[{"text":"invariant between the "},{"text":"Erenna"},{"text":" species, but 16S mtDNA and COI sequences showed a enough variation to "}]},{"bbox":[56.519439697265625,109.75833129882812,541.18017578125,120.19527435302734],"spans":[{"text":"potentially aid in identification. There was variation in the 16S and COI between the California and Mexico "}]},{"bbox":[56.519439697265625,120.84197998046875,541.1708374023438,133.75473022460938],"spans":[{"text":"samples of "},{"text":"E. sirena"},{"text":", but otherwise each species was closest to others of the same species, as expected. Sequences "}]},{"bbox":[56.519447326660156,136.75820922851562,541.2175903320312,147.19515991210938],"spans":[{"text":"were obtained from the following specimens, and have been deposited with GenBank under the accession numbers "}]},{"bbox":[56.519447326660156,150.31765747070312,110.18099975585938,160.75460815429688],"spans":[{"text":"given below."}]},{"bbox":[56.52000045776367,388.7820129394531,113.31006622314453,399.6986999511719],"spans":[{"text":"Conclusions"}]},{"bbox":[56.52000045776367,412.802734375,541.0848388671875,425.7154846191406],"spans":[{"text":"The description here of two new "},{"text":"Erenna"},{"text":" species increases the number of erennids to six. "},{"text":"Parerenna emilyae"},{"text":" Pugh, "}]},{"bbox":[56.521026611328125,428.83905029296875,541.1724853515625,439.2760009765625],"spans":[{"text":"2001 is now the rarest, being known from only a single specimen. However, it is easily distinguished from the "}]},{"bbox":[56.521026611328125,439.8037109375,541.1827392578125,452.7164611816406],"spans":[{"text":"Erenna"},{"text":" species by the lack of compression of the nectophore in the upper/lower plane, and the indistinctiveness of "}]},{"bbox":[56.521026611328125,453.3642272949219,541.1244506835938,466.375],"spans":[{"text":"the ridge system. For the "},{"text":"Erenna"},{"text":" species, "},{"text":"E. insidiator"},{"text":"  "},{"text":"sp. nov."},{"text":" is only known from two specimens, but is clearly "}]},{"bbox":[56.521026611328125,469.2804870605469,541.2117919921875,479.7174377441406],"spans":[{"text":"distinguishable by the long wing- or fish shaped cnidoband on the tentillum. The maximum size of the nectophore "}]},{"bbox":[56.521026611328125,480.3652038574219,541.1234130859375,493.2779541015625],"spans":[{"text":"is approximately the same in all species, except "},{"text":"Erenna laciniata"},{"text":" where they appear to be slightly smaller. "}]},{"bbox":[56.521026611328125,496.2814636230469,530.8854370117188,506.7184143066406],"spans":[{"text":"However, there are certain characters that should easily distinguish them and these are used in the following key:"}]},{"bbox":[56.52000045776367,534.2429809570312,290.8274841308594,547.7786865234375],"spans":[{"text":"Key to "},{"text":"Erenna"},{"text":" species based on their nectophores."}]},{"bbox":[56.52000045776367,563.3575439453125,63.3569450378418,572.35498046875],"spans":[{"text":"1 "}]},{"bbox":[84.23747253417969,563.3575439453125,538.4343872070312,572.35498046875],"spans":[{"text":"Long \"horn\" canals arising from lateral radial canals; thrust block without median indentation  . .  "},{"text":"Erenna cornuta"},{"text":" Pugh, 2001"}]},{"bbox":[56.519989013671875,574.3978881835938,61.79094314575195,583.3953247070312],"spans":[{"text":"- "}]},{"bbox":[84.23117065429688,574.3978881835938,538.303955078125,583.3953247070312],"spans":[{"text":"No \"horn\" canals. Thrust block with median indentation . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .  2"}]},{"bbox":[56.519989013671875,585.4381713867188,61.080352783203125,594.4356079101562],"spans":[{"text":"2"}]},{"bbox":[84.2410659790039,585.4381713867188,538.3067016601562,594.4356079101562],"spans":[{"text":"Mature nectophores with digitate processes on thrust block. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .  3"}]},{"bbox":[56.519989013671875,596.3578491210938,61.79094314575195,605.3552856445312],