8984375],"evidence":["raised_source_span"],"charspan":[377,379],"original":" 1","replacement":"⁻¹"},{"before":"1","after":"⁻¹","source_bbox":[385.010986328125,216.40489196777344,393.8617858886719,226.10546875],"evidence":["raised_source_span"],"charspan":[460,462],"original":" 1","replacement":"⁻¹"},{"before":"","after":"±","source_bbox":[118.79499816894531,231.1432342529297,125.45997619628906,241.1058349609375],"evidence":["aligned_native_and_rendered_sign"],"charspan":[501,501],"original":"","replacement":"±"},{"before":"2","after":"⁻²","source_bbox":[173.75599670410156,229.91392517089844,182.6077880859375,239.614501953125],"evidence":["raised_source_span"],"charspan":[511,513],"original":" 2","replacement":"⁻²"},{"before":"","after":"±","source_bbox":[392.0320129394531,244.65220642089844,398.6969909667969,254.61480712890625],"evidence":["aligned_native_and_rendered_sign"],"charspan":[664,664],"original":"","replacement":"±"},{"before":"-1","after":"⁻¹","source_bbox":[302.2229919433594,202.89488220214844,311.0747985839844,212.595458984375],"evidence":["raised_source_span"],"charspan":[1088,1091],"original":" -1","replacement":"⁻¹"},{"before":"-1","after":"⁻¹","source_bbox":[467.98199462890625,202.89488220214844,476.8327941894531,212.595458984375],"evidence":["raised_source_span"],"charspan":[1125,1128],"original":" -1","replacement":"⁻¹"},{"before":"-1","after":"⁻¹","source_bbox":[385.010986328125,216.40489196777344,393.8617858886719,226.10546875],"evidence":["raised_source_span"],"charspan":[1210,1213],"original":" -1","replacement":"⁻¹"},{"before":"-2","after":"⁻²","source_bbox":[173.75599670410156,229.91392517089844,182.6077880859375,239.614501953125],"evidence":["raised_source_span"],"charspan":[1265,1268],"original":" -2","replacement":"⁻²"}],"unresolved":[],"method":"source_glyph_alignment_v1"}]},"label":"text","prov":[{"page_no":4,"bbox":{"l":76.117,"t":677.7814206484375,"r":526.0917939999987,"b":557.6018188719012,"coord_origin":"BOTTOMLEFT"},"charspan":[0,1574]}],"orig":"Turns in N. bijuga colonies were accomplished by pulsing of a single apical nectophore. Nectophore kinematics and resultant fluid mechanics during turning matched those of straight swimming and are described elsewhere [8]. By pulsing one apical nectophore, colonies were capable of rapid turns with a mean angular velocity, ω , of 104 41 deg. s 1 and a maximum of 215 90 deg. s 1 (Table 1). The maximum measured angular velocity for all colonies was 363 deg. s 1 . The mean peak acceleration was 9795 7469 deg s 2 . Turns were characterized by very little forward motion and a tight turning radius: the average length specific radius of curvature, L / R, was 0.15 0.10 (Table 1). As angular velocity increased, R / L also increased (Figure 2), which was indicative of a trade-o between these two performance variables. Nectophore  kinematics  and  resultant  fluid  mechanics  during  turning  matched  those  of  straight swimming and are described elsewhere [8]. By pulsing one apical nectophore, colonies were capable of rapid turns with a mean angular velocity, ω , of 104 ± 41 deg. s -1  and a maximum of 215 ± 90 deg. s -1  (Table 1). The maximum measured angular velocity for all colonies was 363 deg. s -1 .  The mean peak acceleration was 9795 ± 7469 deg s -2 .  Turns were characterized by very little forward motion and a tight turning radius: the average length specific radius of curvature, L/R, was 0.15 ± 0.10 (Table 1). As angular velocity increased, R/L also increased (Figure 2), which was indicative of a trade-off between these two performance variables.","text":"Turns in N. bijuga colonies were accomplished by pulsing of a single apical nectophore. Nectophore kinematics and resultant fluid mechanics during turning matched those of straight swimming and are described elsewhere [8]. By pulsing one apical nectophore, colonies were capable of rapid turns with a mean angular velocity, ω , of 104 ±41 deg. s⁻¹ and a maximum of 215 ±90 deg. s⁻¹ (Table 1). The maximum measured angular velocity for all colonies was 363 deg. s⁻¹ . The mean peak acceleration was 9795 ±7469 deg s⁻² . Turns were characterized by very little forward motion and a tight turning radius: the average length specific radius of curvature, L / R, was 0.15 ±0.10 (Table 1). As angular velocity increased, R / L also increased (Figure 2), which was indicative of a trade-o between these two performance variables. Nectophore  kinematics  and  resultant  fluid  mechanics  during  turning  matched  those  of  straight swimming and are described elsewhere [8]. By pulsing one apical nectophore, colonies were capable of rapid turns with a mean angular velocity, ω , of 104 ± 41 deg. s⁻¹  and a maximum of 215 ± 90 deg. s⁻¹  (Table 1). The maximum measured angular velocity for all colonies was 363 deg. s⁻¹ .  The mean peak acceleration was 9795 ± 7469 deg s⁻² .  Turns were characterized by very little forward motion and a tight turning radius: the average length specific radius of curvature, L/R, was 0.15 ± 0.10 (Table 1). As angular velocity increased, R/L also increased (Figure 2), which was indicative of a trade-off between these two performance variables."},{"self_ref":"#/texts/11","parent":{"$ref":"#/body"},"children":[],"content_layer":"body","label":"text","prov":[{"page_no":4,"bbox":{"l":102.547,"t":557.2753146484375,"r":137.31939999999997,"b":548.1403146484375,"coord_origin":"BOTTOMLEFT"},"charspan":[0,8]}],"orig":"Table 1.","text":"Table 1."},{"self_ref":"#/texts/12","parent":{"$ref":"#/body"},"children":[],"content_layer":"body","label":"text","prov":[{"page_no":4,"bbox":{"l":137.34730000000002,"t":557.2753146484375,"r":171.48250000000013,"b":548.1403146484375,"coord_origin":"BOTTOMLEFT"},"charspan":[0,9]},{"page_no":4,"bbox":{"l":171.48700000000002,"t":557.2753146484375,"r":261.22599999999994,"b":548.1403146484375,"coord_origin":"BOTTOMLEFT"},"charspan":[10,30]}],"orig":"N. bijuga turning performance.","text":"N. bijuga turning performance."},{"self_ref":"#